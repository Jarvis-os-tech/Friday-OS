# ── Gemini API ─────────────────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ── Hermes Bridge (FRIDAY → Hermes delegation) ─────────────
# Single default profile only — no multi-profile setup
# Binary path — leave as "hermes" to use PATH
HERMES_BIN="hermes"
# Max agent turns per delegated task (prevents runaway loops)
HERMES_MAX_TURNS=12
# Hard timeout (ms) per delegated task. Default 3 min.
HERMES_TIMEOUT_MS=180000
# Address of a running `hermes serve` gateway. Used for live status.
HERMES_GATEWAY_URL="127.0.0.1:9119"

# ── Prime Agent Bridge (FRIDAY → Prime Agent coding) ───────
# Installed: /home/gopi/.nvm/versions/node/v24.19.0/bin/prime-agent
# Leave blank to auto-detect from PATH / NVM
PRIME_AGENT_BIN=""
# Hard timeout (ms) per coding task. Default 5 min.
PRIME_TIMEOUT_MS=300000

# ── OpenClaw / Ultron Bridge ────────────────────────────────
# OpenClaw gateway host and port (default: localhost:18789)
OPENCLAW_GATEWAY_HOST="127.0.0.1"
OPENCLAW_GATEWAY_PORT=18789

# ── Telegram Proactive Notifications ───────────────────────
# 1. Create bot with @BotFather → get token
# 2. Send msg to your bot → get chat_id from:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# ── 24/7 Autonomous Heartbeat ───────────────────────────────
# Interval between background checks in ms (default: 5 min)
HEARTBEAT_INTERVAL_MS=300000
# Cooldown between duplicate alerts in ms (default: 30 min)
ALERT_COOLDOWN_MS=1800000
# Low battery threshold % (default: 15)
BATTERY_LOW_THRESHOLD=15
# High thermal threshold °C (default: 85)
THERMAL_HIGH_THRESHOLD=85

# ── Obsidian Vault ──────────────────────────────────────────
# Path to friday-memory vault (default: ./friday-memory)
OBSIDIAN_VAULT_PATH=""
